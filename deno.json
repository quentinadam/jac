{
  "tasks": {
    "build": "deno run --allow-read --allow-write=dist build.ts",
    "serve": "deno task build && deno run --allow-read=dist --allow-net serve.ts"
  },
  "unstable": ["bundle"],
  "exclude": ["dist"],
  "fmt": {
    "lineWidth": 120,
    "singleQuote": true
  },
  "compilerOptions": {
    "lib": ["deno.ns", "deno.unstable", "dom", "dom.iterable"],
    "strict": true
  }
}
